# Variables de entorno (opcional)
#
# Formulario de contacto — SMTP de Zoho Mail
# Genera una contraseña de aplicación en Zoho:
# Zoho Mail > Configuración > Contraseñas de aplicación
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=contacto@robertsystems.org
ZOHO_SMTP_PASS=tu-contraseña-de-aplicacion
CONTACT_TO=contacto@robertsystems.org

# Panel de administración (/admin)
ADMIN_PASSWORD=tu-contraseña-del-panel
